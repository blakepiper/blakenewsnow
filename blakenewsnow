#!/usr/bin/env bash

set -Eeuo pipefail

# This is a project-local Node environment, not a Python virtualenv. It keeps
# the installed packages in a reusable directory and exposes them through a
# temporary node_modules symlink while the app runs. Ctrl+C stops the child
# processes and removes that symlink; the environment itself is retained so
# the next launch can update it incrementally.

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
ENV_DIR="${BLAKENEWSNOW_ENV_DIR:-$ROOT_DIR/.blakenewsnow-venv}"

if [[ "$ENV_DIR" != /* ]]; then
  ENV_DIR="$ROOT_DIR/$ENV_DIR"
fi

die() {
  echo "blakenewsnow: $*" >&2
  exit 1
}

[[ "$ENV_DIR" != "$ROOT_DIR" ]] || die 'BLAKENEWSNOW_ENV_DIR cannot be the project root'
[[ -f "$ROOT_DIR/package.json" ]] || die 'package.json was not found'
[[ -f "$ROOT_DIR/package-lock.json" ]] || die 'package-lock.json was not found'
[[ -f "$ROOT_DIR/vite.config.ts" ]] || die 'vite.config.ts was not found'

command -v node >/dev/null 2>&1 || die 'Node.js is required (see .nvmrc)'
command -v npm >/dev/null 2>&1 || die 'npm is required'

if ! node -e '
  const [major, minor] = process.versions.node.split(".").map(Number)
  const supported = (major === 24 && minor >= 18) || major >= 26
  process.exit(supported ? 0 : 1)
'; then
  die "unsupported Node.js version $(node --version); use Node 24.18+ or Node 26+"
fi

NPM_MAJOR="$(npm --version | cut -d. -f1)"
if [[ ! "$NPM_MAJOR" =~ ^[0-9]+$ ]] || (( NPM_MAJOR < 11 )); then
  die "npm 11+ is required for the native-package lock metadata (found npm $(npm --version))"
fi

file_hash() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

mkdir -p "$ENV_DIR"

STATE_FILE="$ENV_DIR/.state"
ENV_PACKAGE_JSON="$ENV_DIR/package.json"
ENV_PACKAGE_LOCK="$ENV_DIR/package-lock.json"
ENV_VITE_CONFIG="$ENV_DIR/vite.config.ts"
ENV_NODE_MODULES="$ENV_DIR/node_modules"
NODE_MODULES_LINK="$ROOT_DIR/node_modules"
CONCURRENTLY_BIN="$ENV_DIR/node_modules/.bin/concurrently"
VITE_BIN="$ENV_DIR/node_modules/.bin/vite"
FRONTEND_URL="${BLAKENEWSNOW_FRONTEND_URL:-http://localhost:3000}"

LINK_CREATED=0
SERVICES_PID=0
BROWSER_WAITER_PID=0

# The function is invoked indirectly by the EXIT trap.
# shellcheck disable=SC2329
cleanup() {
  local status=$?
  trap - EXIT INT TERM

  if (( BROWSER_WAITER_PID > 0 )); then
    kill -TERM "$BROWSER_WAITER_PID" 2>/dev/null || true
    wait "$BROWSER_WAITER_PID" 2>/dev/null || true
  fi

  if (( SERVICES_PID > 0 )); then
    kill -TERM "$SERVICES_PID" 2>/dev/null || true
    wait "$SERVICES_PID" 2>/dev/null || true
  fi

  if (( LINK_CREATED == 1 )) && [[ -L "$NODE_MODULES_LINK" ]]; then
    if [[ "$(readlink "$NODE_MODULES_LINK" 2>/dev/null || true)" == "$ENV_NODE_MODULES" ]]; then
      rm -f -- "$NODE_MODULES_LINK"
    fi
  fi

  exit "$status"
}

trap 'exit 130' INT
trap 'exit 143' TERM
trap cleanup EXIT

STATE="$(
  printf 'node=%s\n' "$(node --version)"
  printf 'npm=%s\n' "$(npm --version)"
  printf 'platform=%s/%s\n' "$(node -p 'process.platform')" "$(node -p 'process.arch')"
  printf 'package=%s\n' "$(file_hash "$ROOT_DIR/package.json")"
  printf 'lock=%s\n' "$(file_hash "$ROOT_DIR/package-lock.json")"
)"

STATE_MATCH=0
if [[ -s "$STATE_FILE" ]] && [[ "$(<"$STATE_FILE")" == "$STATE" ]]; then
  STATE_MATCH=1
fi

if (( STATE_MATCH == 0 )) || [[ ! -x "$CONCURRENTLY_BIN" || ! -x "$VITE_BIN" ]]; then
  echo "blakenewsnow: updating project-local environment in $ENV_DIR"
  cp "$ROOT_DIR/package.json" "$ENV_PACKAGE_JSON"
  cp "$ROOT_DIR/package-lock.json" "$ENV_PACKAGE_LOCK"
  cp "$ROOT_DIR/vite.config.ts" "$ENV_VITE_CONFIG"

  if [[ -d "$ENV_DIR/node_modules" ]]; then
    npm install \
      --prefix "$ENV_DIR" \
      --ignore-scripts \
      --no-audit \
      --no-fund
  else
    npm ci \
      --prefix "$ENV_DIR" \
      --ignore-scripts \
      --no-audit \
      --no-fund
  fi

  printf '%s\n' "$STATE" > "$STATE_FILE"
else
  cp "$ROOT_DIR/vite.config.ts" "$ENV_VITE_CONFIG"
  echo "blakenewsnow: reusing project-local environment in $ENV_DIR"
fi

[[ -x "$CONCURRENTLY_BIN" ]] || die 'concurrently was not installed in the project-local environment'
[[ -x "$VITE_BIN" ]] || die 'vite was not installed in the project-local environment'

frontend_ready() {
  BLAKENEWSNOW_FRONTEND_URL="$FRONTEND_URL" node -e '
    const target = new URL(process.env.BLAKENEWSNOW_FRONTEND_URL)
    if (target.hostname === "localhost") target.hostname = "127.0.0.1"

    const http = require(target.protocol === "https:" ? "https" : "http")
    const request = http.get(target, response => {
      response.resume()
      response.once("end", () => {
        process.exit(response.statusCode >= 200 && response.statusCode < 500 ? 0 : 1)
      })
    })
    request.setTimeout(500, () => {
      request.destroy()
      process.exit(1)
    })
    request.on("error", () => process.exit(1))
  ' >/dev/null 2>&1
}

open_browser() {
  if command -v wslview >/dev/null 2>&1; then
    wslview "$FRONTEND_URL" >/dev/null 2>&1 &
    return
  fi

  if [[ "$(uname -s)" == Darwin* ]] && command -v open >/dev/null 2>&1; then
    open "$FRONTEND_URL" >/dev/null 2>&1 &
    return
  fi

  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$FRONTEND_URL" >/dev/null 2>&1 &
    return
  fi

  if command -v open >/dev/null 2>&1; then
    open "$FRONTEND_URL" >/dev/null 2>&1 &
    return
  fi

  if command -v cmd.exe >/dev/null 2>&1; then
    cmd.exe /c start "" "$FRONTEND_URL" >/dev/null 2>&1 &
    return
  fi

  echo "blakenewsnow: no default-browser opener found; open $FRONTEND_URL manually" >&2
}

open_browser_when_ready() {
  local attempt
  for (( attempt = 0; attempt < 120; attempt++ )); do
    if ! kill -0 "$SERVICES_PID" 2>/dev/null; then
      return 0
    fi
    if frontend_ready; then
      echo "blakenewsnow: opening $FRONTEND_URL"
      open_browser
      return 0
    fi
    sleep 0.25
  done

  echo "blakenewsnow: frontend did not become ready; open $FRONTEND_URL manually" >&2
}

if [[ -e "$NODE_MODULES_LINK" || -L "$NODE_MODULES_LINK" ]]; then
  if [[ -L "$NODE_MODULES_LINK" && "$(readlink "$NODE_MODULES_LINK" 2>/dev/null || true)" == "$ENV_NODE_MODULES" ]]; then
    rm -f -- "$NODE_MODULES_LINK"
  else
    die "$NODE_MODULES_LINK already exists; remove it or set up the launcher without a repository node_modules directory"
  fi
fi

ln -s "$ENV_NODE_MODULES" "$NODE_MODULES_LINK"
LINK_CREATED=1

export PATH="$ENV_DIR/node_modules/.bin:$PATH"
export NODE_PATH="$ENV_DIR/node_modules${NODE_PATH:+:$NODE_PATH}"

cd "$ROOT_DIR"

"$CONCURRENTLY_BIN" \
  --kill-others \
  --names api,web \
  --prefix-colors blue,green \
  'node server/proxy.cjs' \
  "vite --config \"$ENV_VITE_CONFIG\"" &
SERVICES_PID=$!

if [[ "${BLAKENEWSNOW_OPEN_BROWSER:-1}" != 0 ]]; then
  open_browser_when_ready &
  BROWSER_WAITER_PID=$!
fi

status=0
wait "$SERVICES_PID" || status=$?

exit "$status"
