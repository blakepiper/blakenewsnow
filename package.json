{
  "name": "blakenewsnow",
  "private": true,
  "version": "0.4.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^24.18.0 || >=26.0.0"
  },
  "scripts": {
    "start": "concurrently \"npm run server:watch\" \"npm run dev\"",
    "dev": "vite",
    "server": "node server/proxy.cjs",
    "server:watch": "node --watch server/proxy.cjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:api": "node tests/diagnostic.cjs",
    "test:unit": "node --test tests/*.test.cjs tests/*.test.ts",
    "test:all": "npm run lint && npm run test:unit && npm run test:api",
    "audit:sources": "node scripts/audit-sources.cjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mozilla/readability": "^0.6.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fast-xml-parser": "5.10.1",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  }
}
