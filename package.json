{
  "name": "blakenewsnow",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "concurrently \"npm run server:watch\" \"npm run dev\"",
    "dev": "vite",
    "server": "node server/proxy.cjs",
    "server:watch": "node --watch server/proxy.cjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:api": "node tests/diagnostic.cjs",
    "test:frontend": "node tests/frontend-diagnostic.cjs",
    "test:unit": "node --test tests/*.test.cjs tests/*.test.ts",
    "test:all": "npm run test:unit && npm run test:frontend && npm run test:api",
    "audit:sources": "node scripts/audit-sources.cjs"
  },
  "dependencies": {
    "@material-ui/core": "4.12.4",
    "@material-ui/icons": "4.11.3",
    "@mozilla/readability": "^0.6.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fast-xml-parser": "5.10.1",
    "jsdom": "^26.1.0",
    "react": "17.0.2",
    "react-dom": "17.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "17.0.89",
    "@types/react-dom": "17.0.26",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
